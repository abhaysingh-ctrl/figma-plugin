# Figma personal access token, scoped to file_content:read + file_metadata:read only.
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret the plugin sends as the `x-audit-secret` header. Generate a
# long random string (e.g. `openssl rand -hex 32`) — this is the only abuse
# control on the public endpoint.
AUDIT_SHARED_SECRET=change-me-to-a-random-string

# Optional: override the default model.
ANTHROPIC_MODEL=claude-sonnet-5
